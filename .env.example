# ──────────────────────────────────────────────────────────────────────
# SPED-HUB — exemplo de configuração por ambiente
# Copie para ``.env`` e ajuste conforme o seu deploy.  NUNCA
# versione o arquivo real: o ``.gitignore`` já impede.
#
# Todas as variáveis abaixo são lidas por ``src/settings.py`` e chegam de
# fato ao CLI, ao dashboard, à API, aos webhooks e aos workers.
# ──────────────────────────────────────────────────────────────────────

# Ambiente: dev (padrão) | test | prod
SPED_HUB_ENV=dev

# Mostra SQL gerado pelo SQLAlchemy
SPED_HUB_DB_ECHO=false

# ── Banco de dados ──────────────────────────────────────────────────────
# Use ``DATABASE_URL`` (padrão SQLAlchemy) para qualquer backend suportado:
#   SQLite:        sqlite:///./sped_hub.db
#   SQLite (abs):  sqlite:////var/lib/sped-hub/sped_hub.db
#   SQLite in-mem: sqlite:///:memory:
#   Postgres:      postgresql+psycopg://user:pass@host:5432/sped_hub
#
# ``SPED_HUB_DB`` continua aceitando um caminho de arquivo SQLite para
# retrocompatibilidade com a Fase 16 e anteriores.  Aceita caminho
# absoluto, relativo ou ``:memory:``.
DATABASE_URL=sqlite:///./sped_hub.db
# SPED_HUB_DB=sped_hub.db

# ── Aplicação ───────────────────────────────────────────────────────────
SPED_HUB_LOG_LEVEL=INFO
# Uma linha JSON por evento, para coletor de logs.  Em ambos os
# formatos, e-mail/CNPJ/CPF/token são mascarados antes de sair.
SPED_HUB_LOG_JSON=false
# Lista separada por vírgula com os domínios que a aplicação aceita no
# cabeçalho Host.  Requisição com Host fora da lista recebe 400.  Aceita
# curinga de subdomínio (``*.escritorio.com.br``, que também cobre o domínio
# nu).  Em produção troque o ``*`` pelo domínio real.
# Loopback (localhost, 127.0.0.1) é sempre aceito, independentemente da lista:
# é o Host que o HEALTHCHECK do container usa.
SPED_HUB_ALLOWED_HOSTS=*
# RESERVADO: nenhum componente consome esta chave hoje.  Sessões e tokens
# usam CSPRNG (``secrets.token_hex``) e o webhook assina com o segredo do
# próprio registro.  Não conte com ela como proteção.
# SPED_HUB_SECRET_KEY=change-me-in-production

# ── Servidor (uvicorn) ──────────────────────────────────────────────────
SPED_HUB_HOST=127.0.0.1
SPED_HUB_PORT=8000
SPED_HUB_RELOAD=false

# ── Uploads e processamento ────────────────────────────────────────────
SPED_HUB_MAX_UPLOAD_MB=200
# Override legado, em bytes.  Quando definido, vence SPED_HUB_MAX_UPLOAD_MB.
# SPED_HUB_MAX_UPLOAD_BYTES=209715200
# Diretório dos arquivos temporários de upload.  Em Docker precisa apontar
# para um volume compartilhado entre o container web e o worker.
# SPED_HUB_UPLOAD_DIR=./uploads
SPED_HUB_ECD_CHUNK_ROWS=5000
SPED_HUB_ECD_CHUNK_BYTES=8388608

# ── Workers ─────────────────────────────────────────────────────────────
WORKER_COUNT=4

# ── Observabilidade ─────────────────────────────────────────────────────
# Retenção da janela de métricas HTTP.  Vale em paralelo com o teto de 20.000
# eventos em memória: sob tráfego alto é o teto que encurta a janela efetiva.
SPED_HUB_MONITORING_RETENTION_HOURS=24
# Janela padrão do painel de monitoramento e do /api/monitoring/summary.
# Quem pede ``?minutes=`` manda; isto é só o padrão, e a retenção acima o
# limita.
SPED_HUB_METRICS_WINDOW_MINUTES=60

# ── Manutenção (expurgo periódico de histórico) ─────────────────────────
# Intervalo entre execuções.  0 desliga a manutenção por completo, e aí o
# histórico de jobs e de entregas de webhook volta a crescer sem limite.
SPED_HUB_MAINTENANCE_INTERVAL_MINUTES=60
# Retenção do histórico de importações concluídas.  0 desliga só este expurgo.
SPED_HUB_JOB_RETENTION_HOURS=24
# Retenção do histórico de entregas de webhook, em dias.  Há uma linha por
# TENTATIVA, não por evento, então integração instável enche a tabela rápido.
# Entrega abandonada (recuperável pelo reenvio) nunca é removida, qualquer que
# seja a idade.  0 desliga só este expurgo.
SPED_HUB_WEBHOOK_RETENTION_DAYS=30
#
# O log de AUDITORIA não entra na manutenção automática, de propósito: é o
# registro de quem mexeu em escrituração fiscal.  A limpeza dele é manual, por
# rota de administrador.

# ── SMTP (e-mail transacional — opcional) ───────────────────────────────
# Chave-geral do envio.  Com `false`, o e-mail só é registrado em log mesmo
# que haja credencial SMTP configurada — é o que protege homologação apontada
# para o SMTP de produção de mandar mensagem a cliente de verdade.
EMAIL_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=          # alias legado aceito: SMTP_PASS
# SMTP_USE_TLS=true
# EMAIL_FROM=noreply@sped-hub.local    # alias legado aceito: SMTP_FROM

# ── Cache / fila ────────────────────────────────────────────────────────
# Sem valor, o cache Redis usa redis://localhost:6379/0 quando acionado.
# REDIS_URL=redis://localhost:6379/0

# ── Webhooks ────────────────────────────────────────────────────────────
# Tentativas de um webhook NOVO (cada registro guarda o próprio valor, então
# mudar aqui não altera os já cadastrados) e timeout de cada tentativa.
SPED_HUB_WEBHOOK_DEFAULT_MAX_RETRIES=3
SPED_HUB_WEBHOOK_TIMEOUT=10
# Permite destino http:// — apenas para desenvolvimento.  Em produção o
# webhook exige https e endereço público (proteção contra SSRF).
SPED_HUB_WEBHOOK_ALLOW_HTTP=false

# ── Rate limiting ───────────────────────────────────────────────────────
# Por API Key, para chave sem cota própria cadastrada.  Cota gravada no banco
# (endpoints /api/v1/keys/{id}/rate-limit) vence esta.
SPED_HUB_RATE_LIMIT_DEFAULT=100
SPED_HUB_RATE_LIMIT_WINDOW=60
# Por IP — protege o que não tem API Key.  Atenção ao NAT: um escritório
# inteiro pode sair por um único IP público, então a cota geral precisa
# acomodar todos os usuários daquele endereço.
SPED_HUB_RATE_LIMIT_IP=300
SPED_HUB_RATE_LIMIT_IP_WINDOW=60
# Login e registro, bem mais apertado: é o que impede varredura de senhas.
SPED_HUB_RATE_LIMIT_LOGIN=10
SPED_HUB_RATE_LIMIT_LOGIN_WINDOW=60
# Só ligue com proxy reverso confiável na frente (o nginx do compose).
# Sem ele, o cliente escreve o próprio X-Forwarded-For e escapa do limite.
SPED_HUB_TRUST_PROXY=false
